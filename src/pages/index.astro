---
// Homepage: Organization + WebSite JSON-LD; topic cards; popular guides,
// senior-dog hub and latest updates (all built from published articles).
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SECTIONS } from '../data/sections';

const SITE = 'https://dogtur.com';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Dogtur',
    url: SITE,
    logo: `${SITE}/favicon.svg`,
    description: 'Independent, research-based dog care guides and honest product reviews.',
    sameAs: [],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Dogtur',
    url: SITE,
    description: 'Dog food guides by breed, gear reviews, health explainers and senior dog care.',
    inLanguage: 'en',
  },
];

const published = await getCollection('articles', ({ data }) => data.status === 'published');
const bySlug = new Map(published.map((a) => [a.data.slug, a]));
const pick = (slugs: string[]) =>
  slugs.map((s) => bySlug.get(s)).filter((a): a is NonNullable<typeof a> => Boolean(a));

// Guides Google already sends the most searchers to (Search Console, Nov 2026).
const popular = pick([
  'best-dog-food-for-less-poop',
  'best-high-fiber-dog-food',
  'dog-proof-trash-cans',
  'best-waterproof-dog-collars',
  'best-dog-food-for-yorkies',
  'best-dog-food-for-maltese',
  'best-dog-foods-for-american-bully',
  'best-dog-food-for-boston-terrier',
  'best-dog-food-for-french-bulldogs',
  'best-dog-food-for-chihuahua',
  'best-dog-food-for-rottweilers',
]);

const senior = pick([
  'what-age-is-a-senior-dog',
  'senior-dog-health-guide',
  'senior-dog-nutrition-guide',
  'senior-dog-mobility-guide',
  'how-to-tell-senior-dog-in-pain',
  'dog-dementia-signs-canine-cognitive-dysfunction',
  'senior-dog-behavior-changes-guide',
  'essential-products-senior-dogs',
]);

const dateOf = (a: (typeof published)[number]) =>
  (a.data.updated ?? a.data.published ?? new Date(0)).getTime();
const latest = [...published].sort((a, b) => dateOf(b) - dateOf(a)).slice(0, 6);
const href = (a: (typeof published)[number]) => `/${a.data.sectionSlug}/${a.data.slug}/`;
---
<BaseLayout
  title="Dogtur — Dog Care Guides, Food by Breed & Honest Gear Reviews"
  description="Research-based dog care: what to feed your breed, which gear is worth buying, health signs to discuss with your vet, and expert-sourced senior dog care."
  canonical={SITE + '/'}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <h1>Honest, research-based dog care.</h1>
      <p class="lede">
        What to feed your breed, which gear is worth the money, and what a
        change in your dog might mean. Every guide shows its sources, and we
        never pretend to have tested what we haven't.
      </p>
    </div>
  </section>

  <div class="wrap">
    <h2>Popular guides</h2>
    <ul class="article-list">
      {popular.map((a) => (
        <li><a href={href(a)}>{a.data.title}</a></li>
      ))}
    </ul>

    <aside class="recommended-cta" aria-label="Free dog calorie calculator">
      <div>
        <strong class="sans">Free dog calculators</strong>
        <p>How much to feed (<a href="/tools/dog-calorie-calculator/">calorie calculator</a>), how old your dog is in human years (<a href="/tools/dog-age-calculator/">age calculator</a>), and how long a ramp should be (<a href="/tools/dog-ramp-calculator/">ramp calculator</a>).</p>
      </div>
      <a class="cta-link sans" href="/tools/">See all tools →</a>
    </aside>

    <h2>Explore by topic</h2>
    <div class="section-grid">
      {SECTIONS.map((s) => (
        <a class="section-card" href={`/${s.slug}/`}>
          <h3>{s.name}</h3>
          <p>{s.blurb}</p>
        </a>
      ))}
    </div>

    <h2>Caring for an older dog</h2>
    <p>
      Senior dogs are where Dogtur started, and still our deepest coverage:
      when "old" begins, what changes, and how to keep an aging dog
      comfortable.
    </p>
    <ul class="article-list">
      {senior.map((a) => (
        <li><a href={href(a)}>{a.data.title}</a></li>
      ))}
    </ul>

    <h2>Recently updated</h2>
    <ul class="article-list">
      {latest.map((a) => (
        <li><a href={href(a)}>{a.data.title}</a></li>
      ))}
    </ul>
  </div>
</BaseLayout>
