---
// Homepage: Organization + WebSite JSON-LD; seven section cards; latest launch queue.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SECTIONS } from '../data/sections';

const SITE = 'https://dogtur.com';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Dogtur',
    url: SITE,
    logo: `${SITE}/favicon.svg`,
    description: 'Independent, research-based senior dog care guides and product reviews.',
    sameAs: [],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Dogtur',
    url: SITE,
    description: 'Senior dog care guides, gear reviews, and honest advice for aging dogs.',
    inLanguage: 'en',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${SITE}/search?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
];

const all = await getCollection('articles', ({ data }) => data.status === 'published');
const queue = (await getCollection('articles'))
  .filter((a) => a.data.publishQueue != null && a.data.status === 'published')
  .sort((a, b) => (a.data.publishQueue ?? 0) - (b.data.publishQueue ?? 0));
---
<BaseLayout
  title="Dogtur — Senior Dog Care Guides & Reviews"
  description="Research-based guides for caring for your aging dog: health, nutrition, mobility, behavior, grooming, gear, and end-of-life — plus honest product reviews."
  canonical={SITE + '/'}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <h1>Caring for your aging dog, done right.</h1>
      <p class="lede">
        Dogtur is an independent guide for parents of senior dogs: honest health
        explainers, nutrition advice, and research-based product reviews
        — not rewritten spec sheets.
      </p>
    </div>
  </section>

  <div class="wrap">
    <h2>Explore by topic</h2>
    <div class="section-grid">
      {SECTIONS.map((s) => (
        <a class="section-card" href={`/${s.slug}/`}>
          <span class={`role-tag ${s.role === 'core' ? 'role-core' : 'role-outer'}`}>
            {s.role === 'core' ? 'Core' : 'Outer'}
          </span>
          <h3>{s.name}</h3>
          <p>{s.blurb}</p>
        </a>
      ))}
    </div>

    <h2>Launch series — the first twelve</h2>
    <p>
      Our first twelve guides build the semantic core of the site: the pillar
      hubs, flagship explainers, and the first research-based reviews —
      hands-on testing to follow.
    </p>
    <ol class="article-list">
      {queue.map((a) => (
        <li>
          <span class="type-tag">{a.data.type}</span>
          <a href={`/${a.data.sectionSlug}/${a.data.slug}/`}>{a.data.title}</a>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>
