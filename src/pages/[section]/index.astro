---
// Section index: one dynamic page per section (e.g. /senior-dog-health/).
// Lists pillar first, then published articles.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { SECTIONS } from '../../data/sections';

export async function getStaticPaths() {
  return SECTIONS.map((s) => ({ params: { section: s.slug }, props: { section: s } }));
}

const { section } = Astro.props;
const SITE = 'https://dogtur.com';

const articles = (await getCollection('articles', ({ data }) => data.sectionSlug === section.slug))
  .sort((a, b) => {
    const rank = (t: string) => (t === 'pillar' ? 0 : t === 'review' ? 1 : t === 'comparison' ? 2 : 3);
    return rank(a.data.type) - rank(b.data.type) || a.data.title.localeCompare(b.data.title);
  });

const published = articles.filter((a) => a.data.status === 'published');

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: section.name,
  description: section.blurb,
  itemListElement: published.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE}/${a.data.sectionSlug}/${a.data.slug}/`,
    name: a.data.title,
  })),
};
---
<BaseLayout
  title={`${section.name} | Dogtur`}
  description={`${section.blurb} Guides and research-based reviews for parents of aging dogs.`}
  canonical={`${SITE}/${section.slug}/`}
  jsonLd={itemListLd}
>
  <div class="wrap">
    <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: section.name }]} />
    <h1>{section.name}</h1>
    <p class="lede">{section.blurb}</p>

    <div class="section-grid">
      <a class="section-card" href="/methodology/"><h3>How we research</h3><p>Our research standards for every review.</p></a>
      <a class="section-card" href="/editorial-policy/"><h3>Editorial policy</h3><p>How we research, fact-check, and stay independent.</p></a>
    </div>

    <h2>Guides</h2>
    <ul class="article-list">
      {published.map((a) => (
        <li>
          <span class="type-tag">{a.data.type}</span>
          <a href={`/${a.data.sectionSlug}/${a.data.slug}/`}>{a.data.title}</a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
